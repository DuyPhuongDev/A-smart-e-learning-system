# Ignore target directories to speed up build
**/target/
!**/target/*.jar

# Ignore IDE files
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Ignore logs
logs/
*.log

# Ignore git
.git/
.gitignore

# Ignore documentation (optional)
*.md
!README.md

# Ignore test files
**/src/test/

# Ignore Maven local cache
.m2/

